{
  "version": 2,
  "cleanUrls": false,
  "git": {
    "deploymentEnabled": true
  },
  "routes": [
    {
      "src": "^/recharge\\.html$",
      "dest": "/recharge.html/"
    },
    {
      "src": "^/shop\\.html$",
      "dest": "/api?path=storefront"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api?path=$1"
    }
  ],
  "redirects": [
    {
      "source": "/recharge.html",
      "destination": "/recharge.html/",
      "permanent": false
    }
  ]
}
