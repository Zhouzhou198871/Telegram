[Unit]
Description=Qingtian Shop FastAPI origin on port 8085
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fakabot-staging
EnvironmentFile=/etc/qingtian-shop.env
ExecStart=/opt/qingtian-shop/venv/bin/uvicorn web_server:app --host 127.0.0.1 --port 8085 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/qingtian-shop /etc/qingtian-shop /opt/fakabot-staging/data

[Install]
WantedBy=multi-user.target
